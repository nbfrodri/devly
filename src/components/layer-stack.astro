---
import { LAYERS, type LayerId } from "@/lib/layers";

type Props = {
	/** Article count per layer; shown in the full-size stack. */
	counts?: Partial<Record<LayerId, number>>;
	/** Article ids per layer; enables the reading progress of each layer. */
	ids?: Partial<Record<LayerId, string[]>>;
	/** Highlights one layer and renders the compact variant used beside an article. */
	current?: LayerId;
};

const { counts, ids, current } = Astro.props;
const compact = current !== undefined;
---

<ol
	class:list={["stack-layers", compact ? "stack-compact" : "stack-build"]}
	style={`--count: ${LAYERS.length}`}
>
	{
		LAYERS.map((layer, depth) => {
			const count = counts?.[layer.id] ?? 0;

			return (
				<li style={`--depth: ${depth}`}>
					<a
						class="layer"
						href={`/capas/${layer.id}/`}
						aria-current={current === layer.id ? "true" : undefined}
						data-progress-group={ids?.[layer.id] ? layer.id : undefined}
						data-steps={ids?.[layer.id]?.join(" ")}
						style={
							compact
								? undefined
								: `--layer-bg: var(--layer-${depth + 1}); --layer-ink: var(--on-layer-${depth + 1})`
						}
					>
						{compact ? (
							layer.name
						) : (
							<>
								<span>
									<span class="layer-name">{layer.name}</span>
									<span class="layer-description">{layer.description}</span>
								</span>
								<span class="layer-count">
									{count > 0 ? count : "Pronto"}
									{count > 0 && (
										<span class="visually-hidden">
											{count === 1 ? " artículo" : " artículos"}
										</span>
									)}
									{ids?.[layer.id] && (
										<span class="layer-progress" data-progress-count="short" />
									)}
								</span>
							</>
						)}
					</a>
				</li>
			);
		})
	}
</ol>
