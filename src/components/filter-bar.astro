---
import Icon from "@/components/icon.astro";
import { KIND_LABELS, KINDS } from "@/lib/kinds";
import type { Layer } from "@/lib/layers";
import { LEVEL_LABELS, LEVELS } from "@/lib/levels";

type Props = {
	/** Layers that have at least one item on the page. */
	layers: readonly Layer[];
	total: number;
	/** Singular and plural noun for the count, e.g. "artículo" and "artículos". */
	singular: string;
	plural: string;
	/** Adds the article type filter. */
	showKinds?: boolean;
};

const { layers, total, singular, plural, showKinds = false } = Astro.props;
---

<form
	class="filter-bar"
	data-filters
	data-singular={singular}
	data-plural={plural}
>
	<div class="filter-field filter-search">
		<label for="filtro-texto">Buscar</label>
		<input
			id="filtro-texto"
			type="search"
			name="text"
			placeholder={`Filtrar ${plural} por título`}
			autocomplete="off"
		/>
	</div>
	<fieldset class="filter-field">
		<legend>Nivel</legend>
		<div class="segmented">
			<label>
				<input type="radio" name="level" value="" checked />
				<span>Todos</span>
			</label>
			{
				LEVELS.map((level) => (
					<label>
						<input type="radio" name="level" value={level} />
						<span>{LEVEL_LABELS[level]}</span>
					</label>
				))
			}
		</div>
	</fieldset>
	{
		showKinds && (
			<div class="filter-field filter-select">
				<label for="filtro-tipo">Tipo</label>
				<div class="select">
					<select id="filtro-tipo" name="kind">
						<option value="">Todos los tipos</option>
						{KINDS.map((kind) => (
							<option value={kind}>{KIND_LABELS[kind]}</option>
						))}
					</select>
				</div>
			</div>
		)
	}
	<div class="filter-field filter-select">
		<label for="filtro-capa">Capa</label>
		<div class="select">
			<select id="filtro-capa" name="layer">
				<option value="">Todas las capas</option>
				{layers.map((layer) => <option value={layer.id}>{layer.name}</option>)}
			</select>
		</div>
	</div>
	<div class="filter-summary">
		<p role="status" data-filter-status>{total} {total === 1 ? singular : plural}</p>
		<button class="text-button" type="reset" data-filter-reset hidden>
			<Icon name="x" />
			Quitar filtros
		</button>
	</div>
</form>

<script>
	import "@/scripts/filters";
</script>
