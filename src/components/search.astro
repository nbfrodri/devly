---
// The Pagefind bundle only exists after `pnpm build`, so search is empty in dev.
---

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<div class="search">
	<span id="search-label">Busca un concepto</span>
	<div id="search" aria-labelledby="search-label"></div>
</div>
<!-- Deferred so the rest of the page is parsed and painted without waiting for it. -->
<script is:inline defer src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
	window.addEventListener("DOMContentLoaded", () => {
		if (window.PagefindUI) {
			new window.PagefindUI({
				element: "#search",
				showSubResults: true,
				showImages: false,
				translations: { placeholder: "variable, DNS, proceso" },
			});
		}
	});
</script>
