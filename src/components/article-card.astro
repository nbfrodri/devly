---
import Icon from "@/components/icon.astro";
import type { Article } from "@/lib/content";
import { KIND_LABELS } from "@/lib/kinds";
import { LEVEL_LABELS } from "@/lib/levels";
import { normalizeForSearch } from "@/lib/text";

type Props = {
	article: Article;
	/** Hidden until the section is expanded or a filter is active. */
	hidden?: boolean;
	/** Position in a learning path; shown above the title. */
	step?: number;
};

const { article, hidden = false, step } = Astro.props;
const { title, description, level, kind } = article.data;
---

<li
	data-item
	data-progress-article={article.id}
	data-levels={level}
	data-kind={kind}
	data-text={normalizeForSearch(`${title} ${description}`)}
	hidden={hidden}
>
	<a class="article-card" href={`/articulos/${article.id}/`}>
		{step !== undefined && <span class="article-card-step">Paso {step}</span>}
		<span class="article-card-title">{title}</span>
		<span class="article-card-description">{description}</span>
		<span class="article-card-meta">
			<span>{LEVEL_LABELS[level]}</span>
			<span class="article-card-tags">
				{kind !== "concepto" && <span class="tag">{KIND_LABELS[kind]}</span>}
				<span class="progress-badge progress-badge-read">
					<Icon name="circle-check-filled" />
					Leído
				</span>
				<span class="progress-badge progress-badge-pending">
					<Icon name="bookmark-filled" />
					Pendiente
				</span>
			</span>
		</span>
	</a>
</li>
