---
import bookmarkFilled from "@tabler/icons/filled/bookmark.svg?raw";
import circleCheckFilled from "@tabler/icons/filled/circle-check.svg?raw";
import arrowLeft from "@tabler/icons/outline/arrow-left.svg?raw";
import arrowRight from "@tabler/icons/outline/arrow-right.svg?raw";
import book from "@tabler/icons/outline/book-2.svg?raw";
import bookmark from "@tabler/icons/outline/bookmark.svg?raw";
import github from "@tabler/icons/outline/brand-github.svg?raw";
import bug from "@tabler/icons/outline/bug.svg?raw";
import circleCheck from "@tabler/icons/outline/circle-check.svg?raw";
import license from "@tabler/icons/outline/license.svg?raw";
import listCheck from "@tabler/icons/outline/list-check.svg?raw";
import moon from "@tabler/icons/outline/moon.svg?raw";
import refresh from "@tabler/icons/outline/refresh.svg?raw";
import sun from "@tabler/icons/outline/sun.svg?raw";
import x from "@tabler/icons/outline/x.svg?raw";

// Tabler Icons, inlined at build time. Add an import here to use another one.
const icons = {
	"arrow-left": arrowLeft,
	"arrow-right": arrowRight,
	book,
	bookmark,
	"bookmark-filled": bookmarkFilled,
	bug,
	"circle-check": circleCheck,
	"circle-check-filled": circleCheckFilled,
	github,
	license,
	"list-check": listCheck,
	moon,
	refresh,
	sun,
	x,
} as const;

type Props = {
	name: keyof typeof icons;
	class?: string;
};

const { name, class: className } = Astro.props;
---

<span class:list={["icon", className]} aria-hidden="true" set:html={icons[name]} />
