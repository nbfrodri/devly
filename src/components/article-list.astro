---
import type { Article } from "@/lib/content";
import { getLayer } from "@/lib/layers";
import { LEVEL_LABELS } from "@/lib/levels";

type Props = {
	articles: Article[];
	/** Hide the layer name when the list already belongs to one layer. */
	showLayer?: boolean;
};

const { articles, showLayer = true } = Astro.props;
---

<ul class="article-list">
	{
		articles.map((article) => (
			<li data-level={article.data.level}>
				<a href={`/articulos/${article.id}/`}>
					<span>
						<span class="article-title">{article.data.title}</span>
						<span class="article-meta">
							{showLayer
								? getLayer(article.data.layer).name
								: article.data.description}
						</span>
					</span>
					<span class="article-meta">
						Nivel {LEVEL_LABELS[article.data.level].toLowerCase()}
					</span>
				</a>
			</li>
		))
	}
</ul>
