---
import { type CollectionEntry, getEntries } from "astro:content";
import SpriteIcon from "@/components/sprite-icon.astro";
import { describeLevelRange } from "@/lib/levels";

type Props = {
	path: CollectionEntry<"paths">;
};

const { path } = Astro.props;
const steps = await getEntries(path.data.steps);
const count = steps.length;
---

<article
	class="path-card"
	data-progress-path={path.id}
	data-steps={path.data.steps.map((step) => step.id).join(" ")}
>
	<h3><a href={`/rutas/${path.id}/`}>{path.data.title}</a></h3>
	<p class="muted">{path.data.description}</p>
	<p class="path-meta">
		<span>{count === 1 ? "1 artículo" : `${count} artículos`}</span>
		<span>{describeLevelRange(steps.map((step) => step.data.level))}</span>
	</p>
	<div class="path-progress">
		<span class="path-progress-bar" aria-hidden="true"></span>
		<span class="path-progress-text">
			<span class="progress-badge progress-badge-read">
				<SpriteIcon name="circle-check-filled" />
				Completada
			</span>
			<span class="progress-badge progress-badge-pending">
				<SpriteIcon name="bookmark-filled" />
				Pendiente
			</span>
			<span data-progress-count></span>
		</span>
	</div>
</article>
