---
import "@/styles/global.css";
import plex400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import plex500 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url";
import plex600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import bricolage from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url";
import Icon from "@/components/icon.astro";
import Logo from "@/components/logo.astro";
import { LAYERS } from "@/lib/layers";

type Props = {
	title: string;
	description: string;
};

const { title, description } = Astro.props;
// Preloaded so text is painted in the right typeface from the first frame.
const fonts = [bricolage, plex400, plex500, plex600];
const { pathname } = Astro.url;
const links = [
	{ href: "/capas/", label: "Capas" },
	{ href: "/rutas/", label: "Rutas" },
	{ href: "/articulos/", label: "Artículos" },
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{
			fonts.map((font) => (
				<link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
			))
		}
		<title>{title} | devly</title>
		<script is:inline>
			// Applied before first paint so a stored choice never flashes the other theme.
			try {
				const stored = localStorage.getItem("tema");
				if (stored === "light" || stored === "dark") {
					document.documentElement.dataset.theme = stored;
				}
			} catch {}

			// The layer stack builds itself once per session; later visits show it at once.
			try {
				if (sessionStorage.getItem("intro")) {
					document.documentElement.classList.add("no-intro");
				} else {
					sessionStorage.setItem("intro", "1");
				}
			} catch {}

		</script>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<div class="container">
				<Logo />
				<div class="site-tools">
					<nav class="site-nav" aria-label="Principal">
						{
							links.map((link) => (
								<a
									href={link.href}
									aria-current={pathname.startsWith(link.href) ? "page" : undefined}
								>
									{link.label}
								</a>
							))
						}
					</nav>
					<button class="theme-toggle" type="button" data-theme-toggle>
						<Icon name="moon" class="theme-icon-moon" />
						<Icon name="sun" class="theme-icon-sun" />
					</button>
				</div>
			</div>
		</header>
		<main id="contenido">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container">
				<div class="footer-brand">
					<Logo />
					<p>
						La informática que se estudia en la carrera y la que se aprende
						trabajando.
					</p>
				</div>
				<nav aria-label="Capas">
					<h2>Capas</h2>
					<ul>
						{
							LAYERS.map((layer) => (
								<li>
									<a href={`/capas/${layer.id}/`}>{layer.name}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<nav aria-label="Explorar">
					<h2>Explorar</h2>
					<ul>
						<li><a href="/rutas/">Rutas de aprendizaje</a></li>
						<li><a href="/articulos/">Todos los artículos</a></li>
						<li><a href="/capas/">Mapa de capas</a></li>
					</ul>
				</nav>
				<nav aria-label="Proyecto">
					<h2>Proyecto</h2>
					<ul>
						<li>
							<a href="https://github.com/nbfrodri/devly" rel="noopener">
								<Icon name="github" />
								Código en GitHub
							</a>
						</li>
						<li>
							<a
								href="https://github.com/nbfrodri/devly/blob/main/docs/content-guide.md"
								rel="noopener"
							>
								<Icon name="book" />
								Cómo se escriben los artículos
							</a>
						</li>
						<li>
							<a href="https://github.com/nbfrodri/devly/issues" rel="noopener">
								<Icon name="bug" />
								Avisar de un error
							</a>
						</li>
					</ul>
				</nav>
				<p class="footer-legal">
					<Icon name="license" />
					Contenido bajo licencia{" "}
					<a href="https://creativecommons.org/licenses/by-sa/4.0/deed.es" rel="license noopener">
						CC BY-SA 4.0
					</a>
					. Código bajo licencia MIT.
				</p>
			</div>
		</footer>
	</body>
</html>

<script>
	// Entrance motion is decoration: load it when the browser is idle so it
	// never competes with first paint.
	const loadMotion = () => import("@/scripts/reveal");
	if ("requestIdleCallback" in window) {
		window.requestIdleCallback(loadMotion, { timeout: 2000 });
	} else {
		setTimeout(loadMotion, 300);
	}

	const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
	const root = document.documentElement;
	const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

	function currentTheme(): "light" | "dark" {
		const chosen = root.dataset.theme;
		if (chosen === "light" || chosen === "dark") return chosen;
		return systemDark.matches ? "dark" : "light";
	}

	function updateLabel() {
		button?.setAttribute(
			"aria-label",
			currentTheme() === "dark" ? "Cambiar a tema claro" : "Cambiar a tema oscuro",
		);
	}

	button?.addEventListener("click", () => {
		const next = currentTheme() === "dark" ? "light" : "dark";
		// Colours ease only during a manual switch, never on page load.
		root.classList.add("theme-switching");
		window.setTimeout(() => root.classList.remove("theme-switching"), 260);
		root.dataset.theme = next;
		try {
			localStorage.setItem("tema", next);
		} catch {
			// Storage can be unavailable; the choice then lasts for this page only.
		}
		updateLabel();
	});

	systemDark.addEventListener("change", updateLabel);
	updateLabel();
</script>
