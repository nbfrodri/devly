---
import { getCollection } from "astro:content";
import ArticleList from "@/components/article-list.astro";
import LayerStack from "@/components/layer-stack.astro";
import PathCard from "@/components/path-card.astro";
import Search from "@/components/search.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { countByLayer, getArticles } from "@/lib/content";

const articles = await getArticles();
const paths = await getCollection("paths");
const firstPath = paths[0];
---

<BaseLayout
	title="La informática, capa por capa"
	description="Lo que se aprende en una ingeniería informática, explicado desde cero: del bit a la inteligencia artificial."
>
	<div class="container">
		<section class="hero">
			<div class="hero-copy">
				<h1>La informática, capa por capa.</h1>
				<p class="lead">
					Lo que se aprende en una ingeniería informática, explicado desde
					cero: del bit a la inteligencia artificial.
				</p>
				<Search />
				{
					firstPath && (
						<p class="muted">
							¿No sabes por dónde empezar?{" "}
							<a href={`/rutas/${firstPath.id}/`}>
								Sigue la ruta de {firstPath.data.title.toLowerCase()}
							</a>
							.
						</p>
					)
				}
			</div>
			<nav class="stack" aria-label="Capas de la informática">
				<div class="stack-axis" aria-hidden="true">
					<span>más abstracto</span>
					<span>más cerca de la máquina</span>
				</div>
				<LayerStack counts={countByLayer(articles)} />
			</nav>
		</section>

		<section class="section">
			<div class="section-intro">
				<h2>Rutas de aprendizaje</h2>
				<p class="muted">
					Una ruta ordena los artículos para que cada uno se apoye en el anterior.
				</p>
			</div>
			<ul class="path-list">
				{
					paths.map((path) => (
						<li>
							<PathCard path={path} />
						</li>
					))
				}
			</ul>
		</section>

		<section class="section">
			<h2>Artículos</h2>
			<ArticleList articles={articles} />
		</section>
	</div>
</BaseLayout>
