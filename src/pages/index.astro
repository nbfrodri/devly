---
import { getCollection } from "astro:content";
import ArticleList from "@/components/article-list.astro";
import LayerStack from "@/components/layer-stack.astro";
import PathCard from "@/components/path-card.astro";
import Search from "@/components/search.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { countByLayer, getArticles } from "@/lib/content";

const articles = await getArticles();
const paths = await getCollection("paths");
const featuredIds = [
	"fundamentos-de-programacion",
	"fundamentos-de-desarrollo-web",
	"como-funciona-internet",
	"como-funciona-un-ordenador",
];
const featured = featuredIds.flatMap(
	(id) => paths.find((path) => path.id === id) ?? [],
);
const firstPath = featured[0];
---

<BaseLayout
	title="La informática, capa por capa"
	description="La informática que se estudia en la carrera y la que se aprende trabajando. Cada concepto explicado a fondo, con ejemplos que funcionan y fuentes para contrastar."
>
	<div class="container">
		<section class="hero">
			<div class="hero-copy">
				<h1>La informática, capa por capa.</h1>
				<p class="lead">
					La informática que se estudia en la carrera y la que se aprende
					trabajando. Cada concepto explicado a fondo, con ejemplos que
					funcionan y fuentes para contrastar.
				</p>
				<Search />
				{
					firstPath && (
						<p class="muted">
							¿No sabes por dónde empezar?{" "}
							<a href={`/rutas/${firstPath.id}/`}>
								Sigue la ruta de {firstPath.data.title.toLowerCase()}
							</a>
							.
						</p>
					)
				}
			</div>
			<nav class="stack" aria-label="Capas de la informática">
				<div class="stack-axis" aria-hidden="true">
					<span>más abstracto</span>
					<span>más cerca de la máquina</span>
				</div>
				<LayerStack counts={countByLayer(articles)} />
			</nav>
		</section>

		<section class="section">
			<div class="section-intro">
				<h2>Rutas de aprendizaje</h2>
				<p class="muted">
					Una ruta ordena los artículos para que cada uno se apoye en el anterior.
				</p>
			</div>
			<ul class="path-grid">
				{
					featured.map((path) => (
						<li>
							<PathCard path={path} compact />
						</li>
					))
				}
			</ul>
			<p><a href="/rutas/">Ver las {paths.length} rutas</a></p>
		</section>

		<section class="section">
			<h2>Artículos al azar</h2>
			<div class="random-articles" data-random-articles>
				<ArticleList articles={articles} />
			</div>
			<script is:inline>
				// Runs right after the list so only the chosen six are ever painted.
				(() => {
					const box = document.currentScript.previousElementSibling;
					const items = [...box.querySelectorAll("li")];

					for (let i = items.length - 1; i > 0; i--) {
						const j = Math.floor(Math.random() * (i + 1));
						[items[i], items[j]] = [items[j], items[i]];
					}

					// Re-append in shuffled order so the visible six come first.
					items.forEach((item, index) => {
						item.hidden = index >= 6;
						item.parentElement.append(item);
					});
					box.dataset.ready = "";
				})();
			</script>
			<p><a href="/articulos/">Ver los {articles.length} artículos</a></p>
		</section>
	</div>
</BaseLayout>
