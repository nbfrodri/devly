---
import { getCollection } from "astro:content";
import ArticleCard from "@/components/article-card.astro";
import Icon from "@/components/icon.astro";
import LayerStack from "@/components/layer-stack.astro";
import PathCard from "@/components/path-card.astro";
import Search from "@/components/search.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { countByLayer, getArticles, idsByLayer } from "@/lib/content";

const articles = await getArticles();
const paths = await getCollection("paths");
const firstPath =
	paths.find((path) => path.id === "fundamentos-de-programacion") ?? paths[0];
---

<BaseLayout
	title="La informática, capa por capa"
	description="La informática que se estudia en la carrera y la que se aprende trabajando. Cada concepto explicado a fondo, con ejemplos que funcionan y fuentes para contrastar."
>
	<div class="container">
		<section class="hero">
			<div class="hero-copy">
				<h1>La informática, capa por capa.</h1>
				<p class="lead">
					La informática que se estudia en la carrera y la que se aprende
					trabajando. Cada concepto explicado a fondo, con ejemplos que
					funcionan y fuentes para contrastar.
				</p>
				<Search variant="hero" />
				{
					firstPath && (
						<div class="hero-start">
							<p>¿No sabes por dónde empezar?</p>
							<a class="button button-primary" href={`/rutas/${firstPath.id}/`}>
								Sigue la ruta de {firstPath.data.title.toLowerCase()}
								<Icon name="arrow-right" />
							</a>
						</div>
					)
				}
			</div>
			<nav class="stack" aria-label="Capas de la informática">
				<div class="stack-axis" aria-hidden="true">
					<span>más abstracto</span>
					<span>más cerca de la máquina</span>
				</div>
				<LayerStack counts={countByLayer(articles)} ids={idsByLayer(articles)} />
			</nav>
		</section>

		<section class="section">
			<div class="section-intro">
				<h2>Rutas de aprendizaje</h2>
				<p class="muted">
					Una ruta ordena los artículos para que cada uno se apoye en el anterior.
				</p>
			</div>
			<div class="random-picks" data-random-picks="6">
				<ul class="path-grid">
					{
						paths.map((path) => (
							<li>
								<PathCard path={path} />
							</li>
						))
					}
				</ul>
			</div>
			<p class="section-actions">
				<button class="button" type="button" data-shuffle>
					<Icon name="refresh" />
					Ver otras seis
				</button>
				<a class="button button-primary" href="/rutas/">
					Ver las {paths.length} rutas
					<Icon name="arrow-right" />
				</a>
			</p>
		</section>

		<section class="section">
			<h2>Para leer hoy</h2>
			<div class="random-picks" data-random-picks="8">
				<ul class="card-grid">
					{articles.map((article) => <ArticleCard article={article} />)}
				</ul>
			</div>
			<p class="section-actions">
				<button class="button" type="button" data-shuffle>
					<Icon name="refresh" />
					Ver otros ocho
				</button>
				<a class="button button-primary" href="/articulos/">
					Ver los {articles.length} artículos
					<Icon name="arrow-right" />
				</a>
			</p>
		</section>
	</div>

	<script is:inline>
		// Each "random picks" list keeps a fresh random handful visible. Runs
		// right after the lists so only the chosen ones are ever painted.
		// What the visitor already read (an article) or finished (a path) is left
		// out; the rules mirror src/lib/progress.ts.
		let read = {};
		try {
			read = JSON.parse(localStorage.getItem("progreso") ?? "{}").articles ?? {};
		} catch {}
		const isDone = (item) => {
			const article = item.dataset.progressArticle;
			if (article) return read[article] === "leido";
			const steps = (item.querySelector("[data-steps]")?.dataset.steps ?? "")
				.split(" ")
				.filter(Boolean);
			return steps.length > 0 && steps.every((step) => read[step] === "leido");
		};

		for (const box of document.querySelectorAll("[data-random-picks]")) {
			const list = box.querySelector("ul");
			const count = Number(box.dataset.randomPicks);

			const pick = () => {
				const all = [...list.children];
				const items = all.filter((item) => !isDone(item));
				for (const item of all) {
					if (isDone(item)) {
						item.hidden = true;
						list.append(item);
					}
				}

				for (let i = items.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));
					[items[i], items[j]] = [items[j], items[i]];
				}

				// Re-insert in shuffled order, ahead of the finished ones, so the
				// visible ones come first.
				items.forEach((item, index) => {
					item.hidden = index >= count;
					list.insertBefore(item, list.children[index] ?? null);
				});
			};

			pick();
			box.dataset.ready = "";
			box.parentElement
				.querySelector("[data-shuffle]")
				?.addEventListener("click", () => {
					pick();
					box.dispatchEvent(
						new CustomEvent("devly:content-change", { bubbles: true }),
					);
				});
		}
	</script>
</BaseLayout>
