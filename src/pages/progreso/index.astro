---
import { getCollection } from "astro:content";
import ArticleCard from "@/components/article-card.astro";
import PathCard from "@/components/path-card.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getArticles } from "@/lib/content";

const articles = await getArticles();
const paths = await getCollection("paths");
// One real card serves as the mould for the cards built from JSON.
const prototype =
	articles.find((article) => article.data.kind !== "concepto") ?? articles[0];
const sections = [
	{
		title: "Rutas pendientes",
		status: "pendiente",
		source: "progreso-rutas",
		list: "path-grid",
		empty: "Ninguna ruta guardada. Usa «Guardar para después» en una ruta.",
	},
	{
		title: "Artículos pendientes",
		status: "pendiente",
		source: "progreso-articulos",
		list: "card-grid",
		empty:
			"Ningún artículo guardado. Usa «Guardar para después» en un artículo.",
	},
	{
		title: "Rutas completadas",
		status: "completa",
		source: "progreso-rutas",
		list: "path-grid",
		empty:
			"Una ruta se completa sola cuando marcas como leídos todos sus artículos.",
	},
	{
		title: "Artículos leídos",
		status: "leido",
		source: "progreso-articulos",
		list: "card-grid",
		empty: "Aún no has marcado ningún artículo como leído.",
	},
];
---

<BaseLayout
	title="Mi progreso"
	description="Los artículos y rutas que has marcado como leídos o pendientes."
>
	<div class="container">
		<header class="page-head">
			<h1>Mi progreso</h1>
			<p class="lead">
				Lo que has leído y lo que has guardado para después. Se guarda solo en este
				navegador: no sale de tu dispositivo y se pierde si borras los datos del sitio.
			</p>
		</header>

		<noscript>
			<p class="empty">Para ver tu progreso hace falta JavaScript.</p>
		</noscript>

		{
			sections.map((section) => (
				<section class="section progress-section" data-progress-section>
					<h2 class="section-title">
						{section.title}
						<span class="section-count" data-progress-total />
					</h2>
					<ul
						class={section.list}
						data-progress-list={section.status}
						data-source={section.source}
						aria-busy="true"
					>
						<li class="skeleton-card" aria-hidden="true" />
						<li class="skeleton-card" aria-hidden="true" />
						<li class="skeleton-card" aria-hidden="true" />
					</ul>
					<p class="empty" data-progress-empty hidden>
						{section.empty}
					</p>
				</section>
			))
		}

		<template id="progreso-rutas">
			{
				paths.map((path) => (
					<li>
						<PathCard path={path} />
					</li>
				))
			}
		</template>
		<template id="progreso-articulos" data-loading></template>
		<template id="progreso-molde">
			{prototype && <ArticleCard article={prototype} />}
		</template>
	</div>
</BaseLayout>

<script>
	type CardData = {
		id: string;
		title: string;
		description: string;
		level: string;
		levelLabel: string;
		kind: string;
		kindLabel: string;
	};

	const target = document.getElementById("progreso-articulos");
	const mould = document.getElementById("progreso-molde");

	/** Fills a copy of the mould card with one article's data. */
	function buildCard(card: HTMLTemplateElement, data: CardData) {
		const item = card.content.firstElementChild?.cloneNode(true) as HTMLElement;
		item.dataset.progressArticle = data.id;
		item.dataset.levels = data.level;
		item.dataset.kind = data.kind;
		item.removeAttribute("data-text");
		item.querySelector("a")?.setAttribute("href", `/articulos/${data.id}/`);
		for (const button of item.querySelectorAll<HTMLElement>("[data-progress-toggle]")) {
			button.dataset.progressId = data.id;
			button.dataset.progressTitle = data.title;
		}
		const set = (selector: string, text: string) => {
			const element = item.querySelector(selector);
			if (element) element.textContent = text;
		};
		set(".article-card-title", data.title);
		set(".article-card-description", data.description);
		set(".article-card-meta > span:first-child", data.levelLabel);
		const tag = item.querySelector(".tag");
		if (data.kindLabel) {
			if (tag) tag.textContent = data.kindLabel;
		} else {
			tag?.remove();
		}
		return item;
	}

	if (target instanceof HTMLTemplateElement && mould instanceof HTMLTemplateElement) {
		fetch("/progreso/articulos.json")
			.then((response) => response.json() as Promise<CardData[]>)
			.then((cards) => {
				target.content.replaceChildren(...cards.map((data) => buildCard(mould, data)));
			})
			.catch(() => {
				// Without the data the article lists stay empty rather than loading forever.
			})
			.finally(() => {
				delete target.dataset.loading;
				document.dispatchEvent(new CustomEvent("devly:progress-refresh"));
			});
	}
</script>
