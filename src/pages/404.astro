---
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout title="Página no encontrada" description="Esta página no existe.">
	<div class="container">
		<header class="page-head">
			<h1>Esta página no existe</h1>
			<p class="lead">
				Puede que el enlace esté mal escrito o que el artículo haya cambiado
				de dirección. Vuelve a la <a href="/">portada</a> o mira todos los <a
					href="/articulos/">artículos</a
				>.
			</p>
		</header>
	</div>
</BaseLayout>
