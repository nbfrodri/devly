---
import ArticleCard from "@/components/article-card.astro";
import FilterBar from "@/components/filter-bar.astro";
import Icon from "@/components/icon.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getArticles } from "@/lib/content";
import { LAYERS } from "@/lib/layers";

/** Cards shown per layer before the "see all" button. */
const LIMIT = 6;

const articles = await getArticles();
const groups = LAYERS.map((layer) => ({
	layer,
	articles: articles.filter((article) => article.data.layer === layer.id),
})).filter((group) => group.articles.length > 0);
---

<BaseLayout
	title="Artículos"
	description="Todos los artículos de devly, agrupados por capa y ordenados de básico a avanzado."
>
	<div class="container">
		<header class="page-head">
			<h1>Artículos</h1>
			<p class="lead">
				{articles.length} artículos, agrupados por capa y ordenados de básico a
				avanzado.
			</p>
		</header>

		<FilterBar
			progressLabels={["Leídos", "Pendientes", "Sin marcar"]}
			layers={groups.map((group) => group.layer)}
			total={articles.length}
			singular="artículo"
			plural="artículos"
			showKinds
		/>

		<div data-filterable>
			{
				groups.map((group) => (
					<section class="section" data-layer={group.layer.id} data-limit={LIMIT}>
						<h2 class="section-title">
							<a class="plain-link" href={`/capas/${group.layer.id}/`}>
								{group.layer.name}
							</a>
							<span class="section-count">{group.articles.length}</span>
						</h2>
						<div
							class="path-progress section-progress"
							data-progress-group={group.layer.id}
							data-steps={group.articles.map((article) => article.id).join(" ")}
						>
							<span class="path-progress-bar" aria-hidden="true" />
							<span class="path-progress-text">
								<span class="progress-badge progress-badge-read">
									<Icon name="circle-check-filled" />
									Capa completada
								</span>
								<span data-progress-count />
							</span>
						</div>
						<ul class="card-grid">
							{group.articles.map((article, index) => (
								<ArticleCard article={article} hidden={index >= LIMIT} />
							))}
						</ul>
						<button
							class="more-button"
							type="button"
							data-expand
							hidden={group.articles.length <= LIMIT}
						>
							Ver los {group.articles.length} artículos
						</button>
					</section>
				))
			}
			<p class="empty" data-filter-empty hidden>
				Ningún artículo coincide con esos filtros.
			</p>
		</div>
	</div>
</BaseLayout>
