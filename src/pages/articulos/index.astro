---
import ArticleList from "@/components/article-list.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getArticles } from "@/lib/content";
import { LAYERS } from "@/lib/layers";
import { LEVEL_LABELS, LEVELS } from "@/lib/levels";

const articles = await getArticles();
const groups = LAYERS.map((layer) => ({
	layer,
	articles: articles.filter((article) => article.data.layer === layer.id),
})).filter((group) => group.articles.length > 0);
---

<BaseLayout
	title="Artículos"
	description="Todos los artículos de devly, agrupados por capa y ordenados de básico a avanzado."
>
	<div class="container">
		<header class="page-head">
			<h1>Artículos</h1>
			<p class="lead">
				Los {articles.length} artículos, agrupados por capa y ordenados de básico
				a avanzado.
			</p>
		</header>

		<div class="filters">
			<div class="filter-row">
				<span class="filter-label" id="filtro-nivel">Mostrar nivel</span>
				<div class="filter-group" role="group" aria-labelledby="filtro-nivel">
					<button type="button" data-level="" aria-pressed="true">Todos</button>
					{
						LEVELS.map((level) => (
							<button type="button" data-level={level} aria-pressed="false">
								{LEVEL_LABELS[level]}
							</button>
						))
					}
				</div>
				<p class="muted" id="filter-status" role="status"></p>
			</div>
			<nav class="filter-row" aria-labelledby="salto-capa">
				<span class="filter-label" id="salto-capa">Ir a la capa</span>
				<ul class="jump-links">
					{
						groups.map((group) => (
							<li data-jump={group.layer.id}>
								<a href={`#${group.layer.id}`}>{group.layer.name}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		{
			groups.map((group) => (
				<section class="section" id={group.layer.id} data-filter-section>
					<h2>
						<a class="plain-link" href={`/capas/${group.layer.id}/`}>
							{group.layer.name}
						</a>
					</h2>
					<ArticleList articles={group.articles} showLayer={false} />
				</section>
			))
		}
	</div>
</BaseLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>(
		".filter-group button",
	);
	const sections = document.querySelectorAll<HTMLElement>(
		"[data-filter-section]",
	);
	const status = document.getElementById("filter-status");

	function applyFilter(level: string) {
		let visible = 0;

		for (const section of sections) {
			let visibleInSection = 0;

			for (const item of section.querySelectorAll<HTMLElement>("li")) {
				const matches = level === "" || item.dataset.level === level;
				item.hidden = !matches;
				if (matches) visibleInSection += 1;
			}

			section.hidden = visibleInSection === 0;
			const jump = document.querySelector<HTMLElement>(
				`[data-jump="${section.id}"]`,
			);
			if (jump) jump.hidden = visibleInSection === 0;
			visible += visibleInSection;
		}

		if (status) {
			status.textContent =
				level === ""
					? ""
					: `${visible} ${visible === 1 ? "artículo" : "artículos"} de este nivel`;
		}
	}

	for (const button of buttons) {
		button.addEventListener("click", () => {
			for (const other of buttons) {
				other.setAttribute("aria-pressed", String(other === button));
			}
			applyFilter(button.dataset.level ?? "");
		});
	}
</script>
