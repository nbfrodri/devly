---
import { getCollection, getEntries, getEntry, render } from "astro:content";
import Icon from "@/components/icon.astro";
import LayerStack from "@/components/layer-stack.astro";
import ProgressButtons from "@/components/progress-buttons.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { type Article, getArticles } from "@/lib/content";
import { findDependents } from "@/lib/dependents";
import { LEVEL_LABELS } from "@/lib/levels";
import { getStepNeighbors } from "@/lib/paths";

export async function getStaticPaths() {
	const articles = await getArticles();
	// Concepts and comparisons first: they are the natural next step; curiosities last.
	const kindOrder = ["concepto", "comparacion", "definicion", "curiosidad"];
	const withPrerequisites = articles
		.map((item) => ({
			id: item.id,
			title: item.data.title,
			kind: item.data.kind,
			prerequisites: item.data.prerequisites.map(
				(prerequisite) => prerequisite.id,
			),
		}))
		.sort((a, b) => kindOrder.indexOf(a.kind) - kindOrder.indexOf(b.kind));

	return articles.map((article) => ({
		params: { id: article.id },
		props: {
			article,
			// Articles that build on this one, easiest first, so readers know where to go next.
			dependents: findDependents(withPrerequisites, article.id, 6),
		},
	}));
}

type Props = {
	article: Article;
	dependents: { id: string; title: string }[];
};

const { article, dependents } = Astro.props;
const { Content } = await render(article);
const prerequisites = await getEntries(article.data.prerequisites);

const paths = (await getCollection("paths")).filter((path) =>
	path.data.steps.some((step) => step.id === article.id),
);
const pathContexts = await Promise.all(
	paths.map(async (path) => {
		const stepIds = path.data.steps.map((step) => step.id);
		const neighbors = getStepNeighbors(stepIds, article.id);

		return {
			path,
			position: stepIds.indexOf(article.id) + 1,
			total: stepIds.length,
			previous: neighbors.previous
				? await getEntry("articles", neighbors.previous)
				: undefined,
			next: neighbors.next
				? await getEntry("articles", neighbors.next)
				: undefined,
		};
	}),
);
const mainContext = pathContexts[0];
---

<BaseLayout title={article.data.title} description={article.data.description}>
	<div class="container article-layout">
		<aside class="article-aside">
			<nav class="aside-block" aria-label="Capa de este artículo">
				<span class="aside-title">Dónde estás</span>
				<LayerStack current={article.data.layer} />
			</nav>
			{
				prerequisites.length > 0 && (
					<div class="aside-block">
						<span class="aside-title">Antes de leer esto</span>
						<ul class="aside-links">
							{prerequisites.map((prerequisite) => (
								<li>
									<a href={`/articulos/${prerequisite.id}/`}>
										{prerequisite.data.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
			{
				dependents.length > 0 && (
					<div class="aside-block">
						<span class="aside-title">Para seguir</span>
						<ul class="aside-links">
							{dependents.map((dependent) => (
								<li>
									<a href={`/articulos/${dependent.id}/`}>{dependent.title}</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
			{
				pathContexts.map((context) => (
					<nav class="aside-block" aria-label={`Ruta ${context.path.data.title}`}>
						<span class="aside-title">En la ruta</span>
						<a class="aside-path" href={`/rutas/${context.path.id}/`}>
							{context.path.data.title}
						</a>
						<span class="muted">
							Paso {context.position} de {context.total}
						</span>
						<ul class="aside-steps">
							{context.previous && (
								<li>
									<span class="muted">Anterior</span>
									<a href={`/articulos/${context.previous.id}/`}>
										{context.previous.data.title}
									</a>
								</li>
							)}
							{context.next && (
								<li>
									<span class="muted">Siguiente</span>
									<a href={`/articulos/${context.next.id}/`}>
										{context.next.data.title}
									</a>
								</li>
							)}
						</ul>
					</nav>
				))
			}
		</aside>

		<article class="article-body" data-pagefind-body>
			<header class="article-head">
				<p class="article-level">Nivel {LEVEL_LABELS[article.data.level].toLowerCase()}</p>
				<h1>{article.data.title}</h1>
				<p class="lead">{article.data.description}</p>
				<ProgressButtons id={article.id} scope="article" />
			</header>
			<div class="prose">
				<Content />
			</div>
			<section class="sources">
				<h2>Fuentes y más información</h2>
				<ul>
					{
						article.data.sources.map((source) => (
							<li>
								<a href={source.url} rel="noopener">
									{source.title}
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<section class="article-finish" aria-label="Al terminar" data-pagefind-ignore>
				<p>¿Has terminado? Márcalo para seguir tu progreso.</p>
				<ProgressButtons id={article.id} scope="article" />
			</section>
			{
				mainContext && (
					<nav class="path-nav" aria-label={`Ruta ${mainContext.path.data.title}`}>
						{mainContext.previous ? (
							<a href={`/articulos/${mainContext.previous.id}/`}>
								<Icon name="arrow-left" />
								{mainContext.previous.data.title}
							</a>
						) : (
							<a href={`/rutas/${mainContext.path.id}/`}>Volver a la ruta</a>
						)}
						{mainContext.next ? (
							<a href={`/articulos/${mainContext.next.id}/`}>
								{mainContext.next.data.title}
								<Icon name="arrow-right" />
							</a>
						) : (
							<a href={`/rutas/${mainContext.path.id}/`}>Fin de la ruta</a>
						)}
					</nav>
				)
			}
		</article>
	</div>
</BaseLayout>
