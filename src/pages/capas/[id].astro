---
import ArticleCard from "@/components/article-card.astro";
import Icon from "@/components/icon.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getArticles } from "@/lib/content";
import { LAYERS, type Layer } from "@/lib/layers";

export function getStaticPaths() {
	return LAYERS.map((layer) => ({
		params: { id: layer.id },
		props: { layer },
	}));
}

type Props = {
	layer: Layer;
};

const { layer } = Astro.props;
const articles = (await getArticles()).filter(
	(article) => article.data.layer === layer.id,
);
---

<BaseLayout title={layer.name} description={layer.description}>
	<div class="container">
		<header class="page-head">
			<p class="article-level">Capa</p>
			<h1>{layer.name}</h1>
			<p class="lead">{layer.description}</p>
			{
				articles.length > 0 && (
					<div
						class="path-progress path-progress-head"
						data-progress-group={layer.id}
						data-steps={articles.map((article) => article.id).join(" ")}
					>
						<span class="path-progress-bar" aria-hidden="true" />
						<span class="path-progress-text">
							<span class="progress-badge progress-badge-read">
								<Icon name="circle-check-filled" />
								Capa completada
							</span>
							<span data-progress-count />
						</span>
					</div>
				)
			}
		</header>
		<section class="section">
			{
				articles.length > 0 ? (
					<ul class="card-grid">
						{articles.map((article) => <ArticleCard article={article} />)}
					</ul>
				) : (
					<p class="empty">
						Todavía no hay artículos en esta capa. Mientras tanto, puedes
						seguir una de las <a href="/rutas/">rutas de aprendizaje</a>.
					</p>
				)
			}
		</section>
	</div>
</BaseLayout>
