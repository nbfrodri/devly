---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/base-layout.astro";

const paths = await getCollection("paths");
---

<BaseLayout title="Rutas" description="Rutas de aprendizaje ordenadas por nivel.">
	<h1>Rutas de aprendizaje</h1>
	<ul>
		{
			paths.map((path) => (
				<li>
					<a href={`/rutas/${path.id}/`}>{path.data.title}</a>
					<p>{path.data.description}</p>
				</li>
			))
		}
	</ul>
</BaseLayout>
