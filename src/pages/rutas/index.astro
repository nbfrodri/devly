---
import { getCollection, getEntries } from "astro:content";
import FilterBar from "@/components/filter-bar.astro";
import PathCard from "@/components/path-card.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { LAYERS } from "@/lib/layers";
import { normalizeForSearch } from "@/lib/text";

const paths = await Promise.all(
	(await getCollection("paths")).map(async (path) => {
		const steps = await getEntries(path.data.steps);

		return {
			path,
			levels: [...new Set(steps.map((step) => step.data.level))].join(" "),
			text: normalizeForSearch(`${path.data.title} ${path.data.description}`),
		};
	}),
);
const groups = LAYERS.map((layer) => ({
	layer,
	paths: paths.filter(({ path }) => path.data.layer === layer.id),
})).filter((group) => group.paths.length > 0);
---

<BaseLayout title="Rutas" description="Rutas de aprendizaje ordenadas paso a paso.">
	<div class="container">
		<header class="page-head">
			<h1>Rutas de aprendizaje</h1>
			<p class="lead">
				Una ruta ordena los artículos para que cada uno se apoye en el anterior.
			</p>
		</header>

		<FilterBar
			progressLabels={["Completadas", "Pendientes", "Sin completar"]}
			layers={groups.map((group) => group.layer)}
			total={paths.length}
			singular="ruta"
			plural="rutas"
		/>

		<div data-filterable>
			{
				groups.map((group) => (
					<section class="section" data-layer={group.layer.id}>
						<h2 class="section-title">
							{group.layer.name}
							<span class="section-count">{group.paths.length}</span>
						</h2>
						<ul class="path-grid">
							{group.paths.map(({ path, levels, text }) => (
								<li data-item data-levels={levels} data-text={text}>
									<PathCard path={path} />
								</li>
							))}
						</ul>
					</section>
				))
			}
			<p class="empty" data-filter-empty hidden>
				Ninguna ruta coincide con esos filtros.
			</p>
		</div>
	</div>
</BaseLayout>
