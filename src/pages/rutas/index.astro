---
import { getCollection } from "astro:content";
import PathCard from "@/components/path-card.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { LAYERS } from "@/lib/layers";

const paths = await getCollection("paths");
const groups = LAYERS.map((layer) => ({
	layer,
	paths: paths.filter((path) => path.data.layer === layer.id),
})).filter((group) => group.paths.length > 0);
---

<BaseLayout title="Rutas" description="Rutas de aprendizaje ordenadas paso a paso.">
	<div class="container">
		<header class="page-head">
			<h1>Rutas de aprendizaje</h1>
			<p class="lead">
				Una ruta ordena los artículos para que cada uno se apoye en el anterior.
			</p>
		</header>
		{
			groups.map((group) => (
				<section class="section">
					<h2>{group.layer.name}</h2>
					<ul class="path-grid">
						{group.paths.map((path) => (
							<li>
								<PathCard path={path} />
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</BaseLayout>
