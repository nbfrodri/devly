---
import { type CollectionEntry, getCollection, getEntries } from "astro:content";
import ArticleList from "@/components/article-list.astro";
import BaseLayout from "@/layouts/base-layout.astro";

export async function getStaticPaths() {
	const paths = await getCollection("paths");

	return paths.map((path) => ({
		params: { id: path.id },
		props: { path },
	}));
}

type Props = {
	path: CollectionEntry<"paths">;
};

const { path } = Astro.props;
const steps = await getEntries(path.data.steps);

if (steps.some((step) => step === undefined)) {
	throw new Error(`Path "${path.id}" references a missing article.`);
}
---

<BaseLayout title={path.data.title} description={path.data.description}>
	<div class="container">
		<header class="page-head">
			<p class="article-level">Ruta de aprendizaje</p>
			<h1>{path.data.title}</h1>
			<p class="lead">{path.data.description}</p>
		</header>
		<section class="section">
			<h2>{steps.length === 1 ? "1 paso" : `${steps.length} pasos`}, en orden</h2>
			<ArticleList articles={steps} />
		</section>
	</div>
</BaseLayout>
